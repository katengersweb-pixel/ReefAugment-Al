# ReefAugment AI Backend Configuration
APP_NAME="ReefAugment AI"
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=25
DATABASE_URL=sqlite:///./database/reefaugment.db

# Hosted SDXL Diffusion Inference Configuration (Backend Only - Never Expose to Frontend)
# Supported providers: huggingface, replicate, stability, custom
DIFFUSION_PROVIDER=huggingface
DIFFUSION_API_KEY=
DIFFUSION_MODEL=stabilityai/stable-diffusion-xl-base-1.0
DIFFUSION_TIMEOUT_SECONDS=120

# Optional provider overrides:
# DIFFUSION_API_BASE_URL=
# DIFFUSION_IMG2IMG_URL=
# DIFFUSION_REPLICATE_VERSION=7762fd07cf82c948538e41f63f77d685e02b063e37e496e96eefd46c929f9bdc
